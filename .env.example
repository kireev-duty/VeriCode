# Copy to .env next to docker-compose.yml and fill in (see docs/08-deploy.md)
PUBLIC_URL=https://talent.example.ru
HTTP_BIND=127.0.0.1
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
EXPOSE_EMAIL_LINKS=true
SEED_DEMO=true

# optional LLM: none | gigachat | yandex | local
LLM_PROVIDER=none
LLM_API_KEY=
LLM_SCOPE=GIGACHAT_API_PERS
